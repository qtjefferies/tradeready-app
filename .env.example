# Copy to .env and fill in. Never commit real values.
# One-time production setup: run lib/schema.sql against your Postgres database.

# Vercel Postgres (or any Postgres) connection string
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Google AI Studio API key — enables AI quote/follow-up/reminder/review drafting.
# Without it, those endpoints return an honest 503 (no fabricated output).
GEMINI_API_KEY=
