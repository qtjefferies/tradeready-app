# Copy to .env and fill in. Never commit real values.
# One-time setup: run lib/schema.sql against your Postgres database.
# It is idempotent — safe to re-run after every deploy that adds columns.

# ---- Required ----------------------------------------------------------

# Vercel Postgres (or any Postgres) connection string.
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Your deployed origin, no trailing slash. Used to build the quote share
# links you send to customers and the password-reset links you email, so a
# wrong value here produces links that don't open.
NEXT_PUBLIC_URL=https://tradeready.app

# ---- AI features -------------------------------------------------------

# Anthropic API key (console.anthropic.com). Enables quote drafting,
# follow-ups, payment reminders, review requests and reactivation messages.
# Without it those endpoints return an honest 503 — never fabricated output.
ANTHROPIC_API_KEY=

# Only needed for an ORG-LEVEL key. A key created inside a workspace already
# carries its workspace and needs nothing here; an org-level one is rejected
# with "not scoped to a workspace" until you set this. Find it in the console
# URL when viewing the workspace, or just create a workspace-scoped key.
# ANTHROPIC_WORKSPACE_ID=

# Optional. Overrides the model. Defaults to claude-haiku-4-5 — the cheap
# option, roughly a fifth the cost per call of the Opus tier, which is what
# keeps a free app affordable. Drafts are shorter and blunter but perfectly
# usable, and the contractor reviews every one before sending it.
#
# Set claude-opus-5 for noticeably better estimating judgement on the quote
# drafter. No code change needed either way.
# ANTHROPIC_MODEL=claude-opus-5

# ---- Password reset email ----------------------------------------------

# Both are required for password reset to work. Without them, /forgot returns
# an honest "not available" rather than pretending to send a mail.
# Resend API key: https://resend.com
RESEND_API_KEY=
# Must be an address on a domain you've verified with the provider.
EMAIL_FROM=TradeReady <noreply@yourdomain.com>
