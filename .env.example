# Copy to .env and fill in. Never commit real values.
# One-time setup: run lib/schema.sql against your Postgres database.
# It is idempotent — safe to re-run after every deploy that adds columns.

# ---- Required ----------------------------------------------------------

# Vercel Postgres (or any Postgres) connection string.
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Your deployed origin, no trailing slash. Used to build the quote share
# links you send to customers and the password-reset links you email, so a
# wrong value here produces links that don't open.
NEXT_PUBLIC_URL=https://tradeready.app

# ---- AI features -------------------------------------------------------

# Enables quote drafting, follow-ups, payment reminders, review requests and
# reactivation messages. Set ONE of the keys below. Without any, those
# endpoints return an honest 503 — never fabricated output.
#
# If more than one is set, the first wins in this order: Hugging Face,
# Ollama, Anthropic. AI_PROVIDER forces one: huggingface | ollama | anthropic
# AI_PROVIDER=huggingface

# Hugging Face token (huggingface.co/settings/tokens) — a fine-grained token
# with "Make calls to Inference Providers" permission.
HF_TOKEN=

# Ollama Cloud API key (ollama.com/settings/keys).
# OLLAMA_API_KEY=
# Self-hosted Ollama instead of the cloud. Must be reachable from wherever
# the app runs — http://localhost:11434 only works in local dev.
# OLLAMA_BASE_URL=http://localhost:11434

# Optional. Overrides the model for Hugging Face / Ollama. Defaults to
# gpt-oss-120b on both ("openai/gpt-oss-120b" on HF, "gpt-oss:120b" on
# Ollama) — cheap, reliable at structured JSON, and good at pricing a job.
# AI_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Anthropic (console.anthropic.com), if you'd rather use Claude.
# ANTHROPIC_API_KEY=
# Only needed for an ORG-LEVEL Anthropic key; a workspace-scoped key needs
# nothing here.
# ANTHROPIC_WORKSPACE_ID=
# Defaults to claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-5

# ---- Password reset email ----------------------------------------------

# Both are required for password reset to work. Without them, /forgot returns
# an honest "not available" rather than pretending to send a mail.
# Resend API key: https://resend.com
RESEND_API_KEY=
# Must be an address on a domain you've verified with the provider.
EMAIL_FROM=TradeReady <noreply@yourdomain.com>
